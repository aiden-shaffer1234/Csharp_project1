<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Maui.eCommerce.Views.CheckOutView"
             Title="CheckOutView"
             NavigatedTo="ContentPage_NavigatedTo">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="10*"/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <ListView
        Grid.Row="0"
        ItemsSource="{Binding Cart}"
        SelectedItem ="{Binding SelectedCartItem}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <ViewCell>
                        <Label Text="{Binding Display}"/>
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <Label Grid.Row="1" Text="{Binding TotalCost, StringFormat='    Total Cost: {0:C}'}" />
        <Button Grid.Row="2" Text="Confirm Checkout" Clicked="ConfirmClicked"/>
        <Button Grid.Row="3" Text="Go Back" Clicked="GoBackClicked"/>
    </Grid>
</ContentPage>